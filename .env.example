# ============================================================
# Vivo Retail Activity App — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# ============================================================

# ── Firebase Configuration ──────────────────────────────────
# Get these from Firebase Console > Project Settings > Your Apps
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# ── Google Sheets Integration (Alternative Backend) ─────────
# Get from Google Cloud Console > APIs & Credentials
REACT_APP_GOOGLE_SHEETS_API_KEY=your_sheets_api_key
REACT_APP_GOOGLE_SHEET_ID=your_google_sheet_id

# ── App Configuration ────────────────────────────────────────
REACT_APP_APP_NAME=Vivo TN Retail Activity
REACT_APP_VERSION=1.0.0
REACT_APP_REGION=Tamil Nadu

# ── Feature Flags ────────────────────────────────────────────
# Set to "true" or "false"
REACT_APP_USE_FIREBASE=true
REACT_APP_ENABLE_EXPORT=true
REACT_APP_ENABLE_DARK_MODE=true
